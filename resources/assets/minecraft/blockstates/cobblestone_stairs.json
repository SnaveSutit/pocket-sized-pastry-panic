{
    "multipart": [
        {
            "apply": [
                {
                    "model": "pspp:block/tile/brick/trim/22_5/line",
                    "x": 270
                }
            ],
            "when": {
                "facing": "east",
                "half": "bottom",
                "shape": "straight"
            }
        },
        {
            "apply": [
                {
                    "model": "pspp:block/tile/brick/trim/22_5/line",
                    "y": 180,
                    "x": 270
                }
            ],
            "when": {
                "facing": "west",
                "half": "bottom",
                "shape": "straight"
            }
        },
        {
            "apply": [
                {
                    "model": "pspp:block/tile/brick/trim/22_5/no_line",
                    "x": 270
                }
            ],
            "when": {
                "facing": "east",
                "half": "bottom",
                "shape": "inner_left"
            }
        },
        {
            "apply": [
                {
                    "model": "pspp:block/tile/brick/trim/22_5/no_line",
                    "y": 180,
                    "x": 270
                }
            ],
            "when": {
                "facing": "west",
                "half": "bottom",
                "shape": "inner_left"
            }
        },
        {
            "apply": [
                {
                    "model": "pspp:block/tile/brick/trim/22_5/no_line",
                    "y": 90,
                    "x": 90
                }
            ],
            "when": {
                "facing": "south",
                "half": "top",
                "shape": "straight"
            }
        }
    ]
