import ./score.mcbt
import ./sequence.mcbt
import ./execute.mcbt
import ./debug.mcbt


function load minecraft:load {
	gamerule max_command_sequence_length 1000000

	create i
	create v
	create mcb.i
	create state

	setworldspawn 0 27 -75 41 90

	schedule 5t replace {
		unless function map:is_world_loaded run return run schedule function ^0 1t replace

		# Auto teardown if map is setup and auto_teardown_on_reload is enabled
		IF (config.dev) {
			if score #map.auto_teardown_on_reload v matches 1 run debug message ['',{"text":"Auto teardown on reload is enabled.","color":"yellow"}]
		}
		if score #map.auto_teardown_on_reload v matches 1 run function ./teardown
		# Setup if map is not setup yet
		if score #map.is_setup v matches 0 run function ./setup
	}

	debug message ['',{"text":"Map reloaded!","color":"green"}]
}


function is_world_loaded {
	REPEAT(-10, 10) as x {
		REPEAT(-10, 10) as z {
			unless loaded ~<%x%> ~ ~<%z%> run return 0
		}
	}
	return 1
}


function setup {
