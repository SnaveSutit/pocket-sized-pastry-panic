import ./score.mcbt
import ./execute.mcbt

function apply_movement_attributes {
	attribute @s minecraft:movement_speed modifier add pspp:elf_speed 0.5 add_multiplied_base
	attribute @s minecraft:jump_strength modifier add pspp:elf_jump 0.5 add_multiplied_base
}

function remove_movement_attributes {
	attribute @s minecraft:movement_speed modifier remove pspp:elf_speed
	attribute @s minecraft:jump_strength modifier remove pspp:elf_jump
}

function get_username {
	summon item_display 0 0 0 {UUID: uuid('39484f6e-23ce-4ba8-9a41-c5e2acce4f03')}
	loot replace entity 39484f6e-23ce-4ba8-9a41-c5e2acce4f03 container.0 loot player:fill_player_head
	data modify storage player:temp username set from entity 39484f6e-23ce-4ba8-9a41-c5e2acce4f03 item.components.minecraft:profile.name
	kill 39484f6e-23ce-4ba8-9a41-c5e2acce4f03
}

loot_table fill_player_head {
	"pools": [
		{
			"rolls": 1,
			"entries": [
				{
					"type": "minecraft:item",
					"name": "minecraft:player_head",
					"modifier": { "type": "minecraft:fill_player_head", "entity": "this" }
				}
			]
		}
	]
}
