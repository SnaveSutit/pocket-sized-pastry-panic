import /math.mcbt
import /execute.mcbt
import /score.mcbt

function load minecraft:load {
	set #2 i 2
	set #5 i 5
	set #10 i 10
	set #25 i 25
	set #40 i 40
	set #50 i 50
	set #100 i 100
}

function get_look_vector2d {
	# Input: The rotation context of the function
	# Outputs: #output.vector.x, #output.vector.z
	positioned 0.0 0.0 0.0 rotated ~ 0 run {
		anchored feet positioned ^ ^ ^1 summon minecraft:marker run {
			data remove storage temp:temp vector
			data modify storage temp:temp vector set from entity @s Pos
			store result score #output.vector.x i run data get storage temp:temp vector[0] 1000
			set #output.vector.y i 0
			store result score #output.vector.z i run data get storage temp:temp vector[2] 1000
			kill @s
		}
	}
}

function get_input_relative_look_vector2d {
	# Must be run as and at the player
	# Outputs: #output.vector.x, #output.vector.z
	set #input.forward v 0
	set #input.backward v 0
	set #input.left v 0
	set #input.right v 0

	if predicate input:key_forward_exclusive run set #input.forward v 1
	if predicate input:key_backward_exclusive run set #input.backward v 1
	if predicate input:key_left_exclusive run set #input.left v 1
	if predicate input:key_right_exclusive run set #input.right v 1

	if score #input.forward v matches 1 \
		if score #input.left v matches 1 \
		rotated ~-45 ~ \
		run return run function math:get_look_vector2d

	if score #input.forward v matches 1 \
		if score #input.right v matches 1 \
		rotated ~45 ~ \
		run return run function math:get_look_vector2d

	if score #input.backward v matches 1 \
		if score #input.left v matches 1 \
		rotated ~-135 ~ \
		run return run function math:get_look_vector2d

	if score #input.backward v matches 1 \
		if score #input.right v matches 1 \
		rotated ~135 ~ \
		run return run function math:get_look_vector2d

	if score #input.forward v matches 1 \
		run return run function math:get_look_vector2d

	if score #input.backward v matches 1 \
		rotated ~180 ~ \
		run return run function math:get_look_vector2d

	if score #input.left v matches 1 \
		rotated ~-90 ~ \
		run return run function math:get_look_vector2d

	if score #input.right v matches 1 \
		rotated ~90 ~ \
		run return run function math:get_look_vector2d
}

function get_look_vector3d {
	# The rotation context of the function
	# Outputs: #output.vector.x, #output.vector.y, #output.vector.z
	positioned 0.0 0.0 0.0 rotated ~ ~ run {
		anchored feet positioned ^ ^ ^1 summon minecraft:marker run {
			data remove storage temp:temp vector
			data modify storage temp:temp vector set from entity @s Pos
			store result score #output.vector.x i run data get storage temp:temp vector[0] 1000
			store result score #output.vector.y i run data get storage temp:temp vector[1] 1000
			store result score #output.vector.z i run data get storage temp:temp vector[2] 1000
			kill @s
		}
	}
}

function sqrt {
	# Inputs: #input
	# Outputs: #output
	# This function calculates the square root of the input value using the Babylonian method.
	load {
		set 2 i 2
	}

	op #output i = #input i
	op #output i /= 2 i
	block {
		op #previous i = #output i
		# x1 = (x0 + #input i / x0) / 2
		op #temp i = #input i
		op #temp i /= #output i
		op #temp i += #output i
		op #temp i /= 2 i
		op #output i = #temp i

		execute if score #previous i > #output i run function ^0
	}

	# tellraw @a [{"text":"Square root of ","color":"gray"},{"score":{"name":"#input","objective":"i"},"color":"white"},{"text":" is ","color":"gray"},{"score":{"name":"#output","objective":"i"},"color":"white"}]
}

function sine {
	# Inputs: #input
	# Outputs: #output
	# DOES NOT PRESERVE THE INPUT VALUE
	load {
		set 3600 i 3600
		set 1800 i 1800
	}
	set #sign i -400

	op #input i %= 3600 i

	if score #input i matches 1800.. run set #sign i 400
	store result score #temp i run op #input i %= 1800 i

	sub #temp i 1800
	store result score #output i run op #temp i *= #input i
	op #output i *= #sign i
	add #temp i 4050000
	op #output i /= #temp i

	# you can remove this line if you dont want the extra 0.01 precision for 180.0-360.0 input range
	execute if score #sign i matches 400 run add #output i 1

	# title @a actionbar [{"text":"Sine of ","color":"gray"},{"score":{"name":"#input","objective":"i"},"color":"white"},{"text":" is ","color":"gray"},{"score":{"name":"#output","objective":"i"},"color":"white"}]
}


function cosine {
	# Inputs: #input
	# Outputs: #output
	# DOES NOT PRESERVE THE INPUT VALUE
	load {
		set 3600 i 3600
		set 1800 i 1800
	}

	set #sign i -400

	add #input i 900
	op #input i %= 3600 i

	execute if score #input i matches 1800.. run set #sign i 400
	execute store result score #temp i run op #input i %= 1800 i

	sub #temp i 1800
	execute store result score #output i run op #temp i *= #input i
	op #output i *= #sign i
	add #temp i 4050000
	op #output i /= #temp i

	# you can remove this line if you dont want the extra 0.01 precision for 180.0-360.0 input range
	execute if score #sign i matches 400 run add #output i 1

	# title @a actionbar [{"text":"Cosine of ","color":"gray"},{"score":{"name":"#input","objective":"i"},"color":"white"},{"text":" is ","color":"gray"},{"score":{"name":"#output","objective":"i"},"color":"white"}]
}

function atan2 {
	# Inputs: #vector.x, #vector.z
	# Outputs: #output
	load {
		set -1 i -1
		set 900 i 900
		set 1000 i 1000
		set 1570 i 1570
		set 1800 i 1800
		set 10000 i 10000
	}

	# Get quadrant of inputs

	set #quadrant_x i 1
	execute if score #vector.x i matches ..-1 run set #quadrant_x i -1
	execute if score #vector.x i matches ..-1 run op #vector.x i *= -1 i

	set #quadrant_y i 1
	execute if score #vector.z i matches ..-1 run set #quadrant_y i -1
	execute if score #vector.z i matches ..-1 run op #vector.z i *= -1 i

	# Switch around inputs if ratio demands it

	set #arctangent_swap_boolean i 0
	execute if score #vector.x i < #vector.z i run set #arctangent_swap_boolean i 1
	execute if score #vector.x i < #vector.z i run op #vector.x i >< #vector.z i

	# Compute function

	op #math_trigonometry_0 i = #vector.z i
	op #math_trigonometry_0 i *= 1000 i
	op #math_trigonometry_0 i /= #vector.x i
	op #math_trigonometry_1 i = #math_trigonometry_0 i
	op #math_trigonometry_0 i *= #math_trigonometry_0 i
	op #math_trigonometry_0 i /= 1000 i

	set #math_trigonometry_2 i 776
	set #math_trigonometry_3 i -2874
	set #math_trigonometry_4 i 9951

	op #math_trigonometry_4 i *= #math_trigonometry_1 i
	op #math_trigonometry_4 i /= 10000 i

	op #math_trigonometry_1 i *= #math_trigonometry_0 i
	op #math_trigonometry_1 i /= 1000 i

	op #math_trigonometry_3 i *= #math_trigonometry_1 i
	op #math_trigonometry_3 i /= 10000 i

	op #math_trigonometry_1 i *= #math_trigonometry_0 i
	op #math_trigonometry_1 i /= 1000 i

	op #math_trigonometry_2 i *= #math_trigonometry_1 i
	op #math_trigonometry_2 i /= 10000 i

	op #output i = #math_trigonometry_2 i
	op #output i += #math_trigonometry_3 i
	op #output i += #math_trigonometry_4 i

	op #output i *= 900 i
	op #output i /= 1570 i

	# Adjust for swap and quadrant

	execute if score #arctangent_swap_boolean i matches 1 run op #output i *= -1 i
	execute if score #arctangent_swap_boolean i matches 1 run add #output i 900

	execute if score #quadrant_x i matches -1 if score #quadrant_y i matches -1 run sub #output i 1800

	execute if score #quadrant_x i matches -1 if score #quadrant_y i matches 01 run op #output i *= -1 i
	execute if score #quadrant_x i matches -1 if score #quadrant_y i matches 01 run add #output i 1800

	execute if score #quadrant_x i matches 01 if score #quadrant_y i matches -1 run op #output i *= -1 i

	sub #output i 900
	op #output i %= 3600 i
}
